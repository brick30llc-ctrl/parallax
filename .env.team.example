# Parallax on your own backends. Copy to .env.local and fill in. Placeholders only here.
#
#   Run both processes locally:  node --env-file=.env.local team-gateway/src/main.js
#   Run the Docker stack:        docker compose --env-file .env.local up --build
#                                (the containers read .env.local itself; --env-file feeds PARALLAX_BIND/PORT)
#
# Inside Docker, "127.0.0.1" means the container itself. Point every *_URL below at an address the
# container can reach: another machine, or http://host.docker.internal:<port> for the Docker host.

# ============================ Parallax: generation ============================

# Where Parallax sends every image, music and speech request. The Docker stack overrides this
# with its own service name. Use the address of the gateway below.
TREG_BASE_URL=http://127.0.0.1:8787
# Parallax sends this as the gateway token. Any long random string, the same value as GATEWAY_TOKEN
# below (make one with: openssl rand -hex 24). It is not a paid-service key.
TREG_TOKEN=replace-with-a-long-random-string
# live = use the gateway. mock = free sample files, no gateway call.
TREG_MODE=live

# ================================== Safety ===================================

# 1 when people reach Parallax over https (a proxy or tunnel in front). 0 for plain http on a LAN or
# localhost. Browsers drop a "secure" cookie on plain http, so 1 without https means nobody can sign in.
COOKIE_SECURE=0
# The address people type to reach Parallax, with no trailing slash, e.g. https://studio.example.com.
# Parallax uses it for links and to check that a request came from its own pages.
PARALLAX_ORIGIN=http://127.0.0.1:3000
# Most Parallax will "spend" in a day, in US dollars of CATALOG price. The team backends cost nothing,
# but Parallax still quotes the paid price, so this works as a cap on how many jobs run per day.
TREG_DAILY_BUDGET_USD=5
# How long Parallax waits for one job before failing it with "timeout", in whole minutes (1 to 120).
# Defaults: 10 for pictures and audio, 30 for video. A slow backend needs more: set this at least as
# high as that backend's own per-task limit (for Kaggle FLUX, KAGGLE_TASK_DEADLINE_MIN plus a few minutes).
# PARALLAX_JOB_TIMEOUT_MIN=10
# PARALLAX_VIDEO_JOB_TIMEOUT_MIN=30
# Parallax gives free "demo" credits to anyone who asks. off closes that, which you want as soon as
# anyone but you can reach the app. Leave it commented out on a private machine to top up for free.
# PARALLAX_DEMO_BILLING=off

# ============================ Docker stack (compose) ============================

# Address and port the stack is published on. This is the access proxy's port; Parallax itself has
# none. 127.0.0.1 keeps it on this machine. A LAN address is fine now, because every request must
# carry a valid Cloudflare Access token.
# PARALLAX_BIND=127.0.0.1
# PARALLAX_PORT=3000

# ======================= Access proxy (Cloudflare Access) =======================
# The access-proxy service checks the Cloudflare Access token on EVERY request before Parallax sees
# it, so the app cannot be reached around Access (a direct LAN visit gets 403). It will not start
# without the first two values, and there is no switch to turn the check off.
# Where to find them: Zero Trust dashboard > Settings (team domain), and the Access application's
# Overview (Application Audience (AUD) Tag).
# Your Access team domain, host only: <team>.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=replace-with-your-team.cloudflareaccess.com
# The Application Audience (AUD) tag of the Access application that fronts Parallax.
ACCESS_AUD=replace-with-the-application-aud-tag
# Optional second check: only these emails (comma list, case-insensitive) get through, even if Access
# lets others in. Leave unset to trust the Access policy alone.
# ACCESS_ALLOWED_EMAILS=
# Where verified requests go. The compose file sets this to the Parallax service; set it yourself only
# when you run the proxy outside Docker:  node --env-file=.env.local access-proxy/src/main.js
# UPSTREAM=http://127.0.0.1:3000
# Tunables (defaults shown): clock skew allowed on exp/nbf/iat; fewest seconds between key fetches
# triggered by an unknown key id; how often the key set is refreshed; how long an upstream
# connection may stay silent (40 minutes, for long generations).
# ACCESS_CLOCK_SKEW_SEC=30
# ACCESS_JWKS_MIN_REFRESH_SEC=30
# ACCESS_JWKS_REFRESH_SEC=3600
# UPSTREAM_TIMEOUT_MS=2400000
# With the proxy in front, PARALLAX_ORIGIN above must be the public https address and COOKIE_SECURE=1,
# because browsers reach the app only through the tunnel.

# ================================== Gateway ==================================

# Where the gateway listens. Loopback by default. The Docker stack sets 0.0.0.0 inside its private network.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
# The token Parallax must send. Required. Same value as TREG_TOKEN.
GATEWAY_TOKEN=replace-with-a-long-random-string
# Waiting calls per backend before new ones are told to retry (Parallax retries by itself).
# GATEWAY_MAX_QUEUE=20
# Calls running or waiting across all backends before new ones are told to retry. Decided before the
# request body is read.
# GATEWAY_MAX_INFLIGHT=40
# Finished results (base64) stay in memory for GATEWAY_RESULT_TTL_MS (default 1 hour), at most
# GATEWAY_MAX_STORED of them and GATEWAY_MAX_STORED_BYTES in all (default 200000000); oldest go first.
# Response size caps per backend, in bytes. A backend that sends more is cut off.
# HORDE_MAX_RESPONSE_BYTES=40000000
# MUSIC_MAX_RESPONSE_BYTES=30000000
# VOICEBOX_MAX_RESPONSE_BYTES=30000000

# ---- Images: an OpenAI-compatible router in front of the AI Horde (OmniRoute or similar) ----
# Base address of the router, without /v1.
OMNIROUTE_URL=http://router.example.lan:20128
# The bearer token the router wants. A keyless router still wants a non-empty value.
OMNIROUTE_TOKEN=replace-me
# The Horde's public model list. The gateway reads it on each request to pick a model that has
# workers online (SDXL-class first, then the shortest wait). Without it, set HORDE_MODEL.
HORDE_STATUS_URL=https://aihorde.net/api/v2/status/models?type=image
# Pin one exact Horde model name instead of choosing live. Optional.
# HORDE_MODEL=
# Used only if the model list cannot be fetched. Optional.
# HORDE_FALLBACK_MODEL=
# Images made at once through the router. The Horde is rate limited; keep this small.
HORDE_CONCURRENCY=2
# Give up on one picture after this many milliseconds. Parallax stops waiting at 10 minutes (600000).
HORDE_TIMEOUT_MS=540000
# Longest side of a picture in pixels. Horde SDXL models top out around 1024.
IMAGE_MAX_SIDE=1024
# Most pictures one request may ask for.
IMAGE_MAX_N=4
# 0 (default). 1 sends FLUX pictures to your own Kaggle GPU (FLUX.1-schnell on a T4 x2 notebook),
# batched: one push makes up to 8 pictures and takes 7 to 12 minutes. Read "Kaggle FLUX" in
# team-gateway/README.md first, and set PARALLAX_JOB_TIMEOUT_MIN=30 (top of this file) before turning it on.
KAGGLE_FLUX=0

# ---- Kaggle FLUX (used only when KAGGLE_FLUX=1). Placeholders only here. ----
# Your Kaggle account name (it owns the private kernel the gateway pushes).
# KAGGLE_USERNAME=your-kaggle-name
# The API token from kaggle.com/settings. Prefer the file form: put just the token in a file only the
# gateway can read (mode 600) and name it. Or use the older KAGGLE_KEY (with KAGGLE_USERNAME) instead.
# KAGGLE_API_TOKEN_FILE=/run/secrets/kaggle_token
# KAGGLE_API_TOKEN=replace-me
# KAGGLE_KEY=replace-me
# The kernel the gateway creates and re-pushes. Pick a name no other kernel of yours uses.
# KAGGLE_KERNEL_SLUG=parallax-flux
# Which image models go to Kaggle: flux (only the FLUX id, default), all, or a comma list of parts of
# endpoint ids such as flux,gemini.
# KAGGLE_IMAGE_MODELS=flux
# What to do when a limit below stops a request: horde (use the AI Horde, default) or none (fail with a
# message the member can read).
# KAGGLE_FALLBACK=horde
# Requests arriving within this many seconds of the first share one push, up to KAGGLE_MAX_BATCH pictures.
# KAGGLE_BATCH_WINDOW_SEC=20
# KAGGLE_MAX_BATCH=8
# Most pushes in any 24 hours (each costs 7 to 12 minutes of GPU). KAGGLE_STATE_FILE remembers them
# across restarts (a writable path); without it a restart resets the count.
# KAGGLE_DAILY_PUSH_CAP=12
# KAGGLE_STATE_FILE=/data/kaggle-pushes.json
# Requests allowed to wait for a push.
# KAGGLE_MAX_QUEUE=16
# Do not push when the weekly GPU time left is below this many hours (0 turns the check off).
# KAGGLE_MIN_GPU_HOURS=0.5
# One request's total wait, in minutes. PARALLAX_JOB_TIMEOUT_MIN must be at least this: Parallax gives up
# and refunds the member when its own limit passes first.
# KAGGLE_TASK_DEADLINE_MIN=25
# A pushed kernel that has not started after this many minutes counts as stalled. One that has not
# finished this long after starting counts as hung. The kernel also stops itself after the watchdog.
# KAGGLE_START_TIMEOUT_MIN=12
# KAGGLE_RUN_TIMEOUT_MIN=35
# KAGGLE_KERNEL_WATCHDOG_MIN=30
# Longest side of a picture (up to 1536; area is always capped at 1024 x 1024) and most pictures per request.
# KAGGLE_MAX_SIDE=1024
# KAGGLE_MAX_N=4

# ---- Music and sound: a Stable Audio Open job server ----
# Base address. It takes one job at a time; the gateway queues the rest.
MUSIC_URL=http://music.example.lan:8890
# Denoising steps. More is slower. The server accepts 20 to 200.
MUSIC_STEPS=100
# Default clip lengths in seconds (5 to 47) when the prompt does not name one.
# MUSIC_CLIP_SECONDS=15
# MUSIC_FULL_SECONDS=30

# ---- Speech: a Voicebox server ----
# Base address. Requests run one at a time.
VOICEBOX_URL=http://voice.example.lan:17493
# The one engine to use. Keep it a light one; loading a big model can wedge a small server.
VOICEBOX_ENGINE=kokoro
# Voice profile id to speak with. Empty = the first preset profile for the engine.
# VOICEBOX_PROFILE_ID=

# ================================= Agent chat =================================
# Pick ONE of the two options. Option A is the tested one.

# ---- Option A: Parallax's built-in engine through an Anthropic-format router endpoint ----
# SUPER_MODE=live switches the assistant on. Computer and connector tools stay mock without their own keys.
SUPER_MODE=live
# The router's base address, no /v1 (the Anthropic SDK adds /v1/messages itself).
ANTHROPIC_BASE_URL=http://router.example.lan:20128
# A non-empty bearer for the router. A keyless router accepts any value.
ANTHROPIC_API_KEY=replace-me
# The model name the router should serve. A router "auto" alias picks a healthy model.
SUPER_LLM_MODEL=auto/best-chat

# ---- Option B: a Hermes agent does the thinking (leave these unset for Option A) ----
# Needs an extra mcp_servers entry added to the agent's own config so it can call back into
# Parallax, and the agent must be able to reach Parallax's address. See team-gateway/README.md.
# SUPER_ENGINE=hermes
# HERMES_URL=http://agent.example.lan:8642
# The agent's API_SERVER_KEY.
# HERMES_API_KEY=replace-me
# What the agent shows when it calls Parallax's tools. 24+ random characters; the same value goes
# in the agent's mcp_servers Authorization header.
# SUPER_ENGINE_TOKEN=replace-me-with-24-or-more-random-characters
# HERMES_MODEL=hermes-agent
